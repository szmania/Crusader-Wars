    <Compile Remove="BookmarksPlus\OptionsTabTests.cs" />
    <Compile Remove="BookmarksPlus\MainFilePlaythroughTests.cs" />
    <Compile Remove="MigrationServiceTests.cs" />
    <Compile Remove="SiegesTests.cs" />
    <Compile Remove="Rome2GameServiceTests.cs" />
